# Copie este arquivo para `.env` (desenvolvimento local) e preencha os
# valores reais. NUNCA versionar `.env`/`.env.local` — ver .gitignore e
# GUARDRAILS.md regra 15.

# --- Banco de dados (Prisma / PostgreSQL) — usado a partir de L1-T02 ---
# String de conexão PostgreSQL usada pelo Prisma Client/Migrate.
DATABASE_URL="postgresql://user:password@localhost:5432/curtamais?schema=public"

# --- Autenticação (NextAuth.js) — usado a partir de L1-T03 ---
# Segredo usado para assinar/criptografar cookies e tokens de sessão do
# NextAuth. Gerar com: `openssl rand -base64 32`.
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-gerado-localmente"
# URL canônica da aplicação, usada pelo NextAuth para callbacks.
NEXTAUTH_URL="http://localhost:3000"

# --- Gateway de IA (OpenAI) — usado a partir de L3-T01 ---
# Chave de API do provider OpenAI. Só via variável de ambiente/secrets
# manager da plataforma de deploy — nunca versionada (GUARDRAILS.md regra 15).
OPENAI_API_KEY="sk-..."
# Modelo usado pelo Gateway de IA (ADR-002).
OPENAI_MODEL="gpt-4o-mini"

# --- Rate limiting do Gateway de IA (L3-T05) ---
# Limite de chamadas ao Gateway de IA por sessão/IP em uma janela de tempo.
AI_GATEWAY_RATE_LIMIT_PER_MINUTE="10"
