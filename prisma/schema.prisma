// Schema de persistência estruturada (ADR-005, SDD.md Seção 5).
//
// TripSession é a raiz de agregação; cada uma das quatro entidades de etapa
// (DestinationApproval, AccommodationApproval, ActivityApproval,
// ItineraryItem) só existe quando a etapa correspondente foi aprovada — isso
// é o que expressa RN-03 (sessão "concluída com valor" com só uma etapa
// aprovada): linha ausente = etapa não aprovada, não um erro.
//
// Este schema é desenhado para ser ESTENDIDO (não recriado) pela Fase 2 —
// nenhuma tabela de Fase 2 (Checklist, TripDocument, Expense, TripMember) é
// criada aqui (GUARDRAILS.md, ressalva 1 do log de aprovação).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (SDD.md Seção 5) --------------------------------------------

enum TripEntryPath {
  data_livre
  feriado
  quiz
}

enum TripSessionStatus {
  in_progress
  partial
  completed
  abandoned
}

// Estado granular do Orquestrador de Sessão (ADR-006, Adendo 1). Reaproveita
// literalmente o vocabulário de `SESSION_FLOW_STATES`
// (`src/lib/session-flow/state-machine.ts`, L4-T01) — nenhum segundo
// vocabulário. Coexiste com `TripSessionStatus` acima (granularidade
// grosseira para filtros administrativos + estado `abandoned`, fora do
// vocabulário desta state machine); sincronizado com ele só nos terminais
// (`concluida`→`completed`, `encerrada_parcial`→`partial`), ver L4-T02.
enum SessionFlowState {
  entrada_selecionada
  destino_pendente
  destino_confirmado
  hospedagem_pendente
  hospedagem_aprovada
  passeios_pendente
  passeios_aprovados
  roteiro_pendente
  roteiro_aprovado
  concluida
  encerrada_parcial
}

enum DestinationSource {
  ia_suggested
  user_provided
}

enum ItineraryPeriod {
  manha
  tarde
  noite
}

enum LlmStage {
  destino
  hospedagem
  passeios
  roteiro
}

enum LlmGenerationStatus {
  success
  failed_after_retry
}

// --- Autenticação (NextAuth.js, L1-T03, SDD §7) ----------------------------
//
// Schema padrão do Prisma Adapter oficial do NextAuth (User/Account/Session/
// VerificationToken), com convenção de @map já usada no restante deste
// arquivo. `User.passwordHash` é uma extensão deliberada ao schema padrão do
// adapter, necessária porque o provider escolhido (Credentials — e-mail/
// senha, ver decisão em L1-T03) não persiste credencial via OAuth account;
// o adapter continua responsável por User/Account/VerificationToken. Como a
// estratégia de sessão do NextAuth é "jwt" (obrigatório com Credentials
// Provider — ver `src/lib/auth.ts`), a tabela `Session` não é escrita pelo
// NextAuth em tempo de execução, mas é mantida por ser exigida pela
// interface do Prisma Adapter e para não fechar a porta a outro provider
// (ex.: magic link) que volte a usar sessão de banco no futuro.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Entidades ------------------------------------------------------------

// Raiz de agregação do fluxo guiado (RN-01/RF-05, ADR-006).
model TripSession {
  id       String @id @default(uuid())
  // Nullable: fluxo funciona sem conta (sessão anônima via cookie, SDD §7).
  // Ainda sem relation/FK formal para User (fora do escopo de L1-T03 —
  // migração de dados de TripSession para userId autenticado é L4); L1-T03
  // só garante que userId autenticado fica disponível para uso futuro.
  userId   String? @map("user_id")

  entryPath TripEntryPath @map("entry_path")

  // Nullable até RF-04 resolver o destino (SDD.md Seção 5, literal).
  dateRangeStart DateTime? @map("date_range_start") @db.Date
  dateRangeEnd   DateTime  @map("date_range_end") @db.Date

  budgetAmount   Decimal? @map("budget_amount") @db.Decimal(10, 2)
  budgetCurrency String?  @map("budget_currency")

  status TripSessionStatus @default(in_progress)
  // Fonte de verdade dos 11 estados granulares do ADR-006 (Adendo 1) — é
  // este campo, não `status` acima, que `transitionSessionFlow`
  // (`src/lib/session-flow`) lê/escreve a cada transição (L4-T02).
  flowState SessionFlowState @default(entrada_selecionada) @map("flow_state")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  destinationApproval    DestinationApproval?
  accommodationApproval  AccommodationApproval?
  activityApprovals      ActivityApproval[]
  itineraryItems         ItineraryItem[]
  llmGenerationLogs      LlmGenerationLog[]

  @@map("trip_sessions")
}

// 0..1 por sessão — só existe quando a etapa de destino foi aprovada (RF-04/RF-11).
model DestinationApproval {
  id        String @id @default(uuid())
  sessionId String @unique @map("session_id")

  name String

  // Nullable quando source = user_provided (SDD.md Seção 5, literal).
  justification String? @db.Text

  priceRangeMin Decimal @map("price_range_min") @db.Decimal(10, 2)
  priceRangeMax Decimal @map("price_range_max") @db.Decimal(10, 2)

  source DestinationSource

  approvedAt DateTime @map("approved_at")

  session TripSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("destination_approvals")
}

// 0..1 por sessão — só existe quando a etapa de hospedagem foi aprovada (RF-06).
model AccommodationApproval {
  id        String @id @default(uuid())
  sessionId String @unique @map("session_id")

  name String
  type String

  pricePerNightMin Decimal @map("price_per_night_min") @db.Decimal(10, 2)
  pricePerNightMax Decimal @map("price_per_night_max") @db.Decimal(10, 2)

  distinctiveFeature String @map("distinctive_feature")

  approvedAt DateTime @map("approved_at")

  session TripSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("accommodation_approvals")
}

// 0..n por sessão — cada item de passeio/atividade aprovado (RF-07).
model ActivityApproval {
  id        String @id @default(uuid())
  sessionId String @map("session_id")

  name String

  priceMin Decimal @map("price_min") @db.Decimal(10, 2)
  priceMax Decimal @map("price_max") @db.Decimal(10, 2)

  isFree          Boolean @map("is_free")
  durationApprox  String  @map("duration_approx")
  orderIndex      Int     @map("order_index")

  approvedAt DateTime @map("approved_at")

  session       TripSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itineraryItem ItineraryItem?

  @@map("activity_approvals")
}

// 0..n por sessão — item estruturado do roteiro final por dia/período (RF-08).
model ItineraryItem {
  id         String  @id @default(uuid())
  sessionId  String  @map("session_id")
  // Nullable: nem todo item de roteiro precisa referenciar um passeio aprovado.
  activityId String? @unique @map("activity_id")

  dayDate DateTime        @map("day_date") @db.Date
  period  ItineraryPeriod

  suggestedTime String @map("suggested_time")

  // Nullable: justificativa de timing nem sempre presente (SDD.md Seção 5, literal).
  timingJustification String? @map("timing_justification") @db.Text

  sequenceOrder Int @map("sequence_order")

  session  TripSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activity ActivityApproval? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@map("itinerary_items")
}

// 0..n por sessão — observabilidade de toda chamada ao provider de LLM
// (TASK.md Seção 1, item 8; GUARDRAILS.md regra 13).
model LlmGenerationLog {
  id        String @id @default(uuid())
  sessionId String @map("session_id")

  stage         LlmStage
  provider      String
  promptVersion String   @map("prompt_version")

  tokensInput     Int     @map("tokens_input")
  tokensOutput    Int     @map("tokens_output")
  costEstimateUsd Decimal @map("cost_estimate_usd") @db.Decimal(10, 6)
  latencyMs       Int     @map("latency_ms")
  retryCount      Int     @map("retry_count")

  status LlmGenerationStatus

  createdAt DateTime @default(now()) @map("created_at")

  session TripSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("llm_generation_logs")
}
